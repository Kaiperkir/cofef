generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  password     String
  role         String    @default("USER")
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  refreshToken String?
  orders       Order[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id            Int              @id @default(autoincrement())
  name          String
  brand         String?
  barcode       String?          @unique
  description   String?
  imageUrl      String?
  categoryId    Int
  roast         String?
  acid          Float?
  body          Float?
  sca           Float?
  region        String?
  origin        String?
  notes         String?
  composition   String?
  prep_method   String?
  brewing_temp  String?
  steeping_time String?
  tea_type      String?
  storage       String?
  isTop         Boolean          @default(false)
  isWeekly      Boolean          @default(false)
  isSpecialty   Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  category      Category         @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  weight    Int
  price     Int
  stock     Int     @default(0)
  oldPrice  Int?
  product   Product @relation(fields: [productId], references: [id])
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int?
  total     Int
  status    String      @default("PENDING")
  address   String?
  phone     String?
  comment   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User?       @relation(fields: [userId], references: [id])
  OrderItem OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int?
  name      String
  price     Int
  weight    Int
  grind     String?
  Order     Order   @relation(fields: [orderId], references: [id])
}
